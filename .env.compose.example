# Copy to .env.compose; generate separate random passwords before starting.
COMPOSE_PROJECT_NAME=netdisk
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=

# Only the frontend is published; keep loopback when using a local HTTPS proxy.
NETDISK_BIND_ADDRESS=127.0.0.1
NETDISK_HTTP_PORT=8080
NETDISK_WEB_CONTEXT=../NetdiskWeb
NETDISK_BACKEND_IMAGE=netdisk-backend:local
NETDISK_FRONTEND_IMAGE=netdisk-web:local
NETDISK_UID=10001
NETDISK_GID=10001
NETDISK_TIMEZONE=Asia/Shanghai

# For HTTPS set the exact public origin and secure cookie; no wildcards.
NETDISK_ALLOWED_ORIGINS=http://127.0.0.1:8080
NETDISK_COOKIE_SECURE=false
NETDISK_ADMIN_EMAILS=

# Empty credentials keep mail verification unavailable. SMTPS is the current protocol.
NETDISK_MAIL_HOST=smtp.qq.com
NETDISK_MAIL_PORT=465
NETDISK_MAIL_USER=
NETDISK_MAIL_PASSWORD=
NETDISK_MAIL_CONNECT_TIMEOUT_MS=5000
NETDISK_MAIL_READ_TIMEOUT_MS=10000
NETDISK_MAIL_WRITE_TIMEOUT_MS=10000

# QQ requires an approved external app and an exact public HTTPS callback.
NETDISK_QQ_ENABLED=false
NETDISK_QQ_APP_ID=
NETDISK_QQ_APP_KEY=
NETDISK_QQ_REDIRECT=

NETDISK_UPLOAD_TASK_TTL_HOURS=24
NETDISK_UPLOAD_RECEIPT_TTL_HOURS=168
NETDISK_UPLOAD_CLEANUP_ENABLED=true
NETDISK_RECYCLE_RETENTION_DAYS=30
